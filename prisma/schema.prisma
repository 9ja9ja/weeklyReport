generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  division  String   @default("") // deprecated (임원 그룹 식별에만 사용)
  orderIdx  Int      @default(0)
  createdAt DateTime @default(now())

  // 공동 편집 컷오버 구간 — 이 주차부터 SharedDoc 을 쓰고 개인 Report 쓰기를 막는다.
  // 팀·주차 단위로 판단해야 이미 공동 편집한 주차를 legacy 로 되돌리는 사고를 막을 수 있다.
  //
  // 끌 때 collabFrom 을 지우지 않고 collabUntil 을 채우는 이유:
  // 이미 함께 작성한 주차까지 legacy 로 되돌아가면 그 주차 저장이 개인 Report 기준으로
  // 재생성돼 공동 문서 내용을 덮어쓴다. 지난 주차는 공동 편집인 채로 남겨둬야 한다.
  collabFromYear  Int?
  collabFromWeek  Int?
  collabUntilYear Int?
  collabUntilWeek Int?

  users           User[]
  userTeams       UserTeam[]
  parts           Part[]
  majorCategories MajorCategory[]
  categories      Category[]
  summaryData     SummaryData[]
  summaryLocks    SummaryLock[]
  sharedDocs      SharedDoc[]
  docActivities   DocActivity[]
  writingExcuses  WritingExcuse[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  teamId       Int // 주 소속팀
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role         String   @default("user") // "superAdmin" | "teamMaster" | "user"
  position     String   @default("") // 직급: 팀장 | 부팀장 | 매니저 | 프로
  password     String   @default("NOT_SET")
  mustChangePw Boolean  @default(true)
  isActive     Boolean  @default(true)
  /// 권한 잠금 — 켜면 권한 변경·삭제가 화면에서 아예 불가능하다(비밀번호 초기화도 최고관리자만).
  /// 시스템을 되돌릴 최후의 계정을 지키는 값이라 **화면에서는 켜고 끌 수 없다** — DB 로만 바꾼다.
  roleLocked   Boolean  @default(false)
  createdAt    DateTime @default(now())

  reports        Report[]
  userTeams      UserTeam[]
  docActivities  DocActivity[]
  writingExcuses WritingExcuse[]

  improvements         Improvement[]        @relation("improvementAuthor")
  improvementAssigned  Improvement[]        @relation("improvementAssignee")
  improvementComments  ImprovementComment[] @relation("improvementComment")

  @@unique([teamId, name])
}

// 겸직 지원: 한 사람이 여러 팀의 보고 항목을 작성
model UserTeam {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  /// 팀 안에서의 표시 순서. 직급 순으로 보여야 하는 팀(임원 등)이 있어 이름순만으로는 부족하다.
  /// 지정하지 않은 사람은 999 로 남아 이름순으로 뒤에 붙는다 —
  /// 0 을 기본으로 두면 새로 추가된 사람이 맨 위로 튀어 오른다.
  orderIdx  Int      @default(999)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}

// 문서 "분류1" — 대분류 위 레벨
model Part {
  id        Int      @id @default(autoincrement())
  name      String
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  majorCategories MajorCategory[]
  categories      Category[]

  @@unique([teamId, name])
}

// 문서 "분류2" — 대분류
model MajorCategory {
  id        Int      @id @default(autoincrement())
  name      String
  partId    Int
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([partId, name])
  @@index([teamId])
}

// 문서 셀 내 "⑴" — 중분류
model Category {
  id        Int      @id @default(autoincrement())
  major     String // MajorCategory.name 과 대응
  middle    String
  partId    Int
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  reportItems ReportItem[]

  @@unique([partId, major, middle])
  @@index([teamId])
}

model Report {
  id      Int  @id @default(autoincrement())
  userId  Int
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  year    Int
  weekNum Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReportItem[]

  @@unique([userId, year, weekNum])
  @@index([year, weekNum])
}

model ReportItem {
  id              Int      @id @default(autoincrement())
  reportId        Int
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentContents String   @default("[]")
  nextContents    String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([reportId, categoryId])
  @@index([categoryId])
}

model SummaryData {
  id        Int      @id @default(autoincrement())
  year      Int
  weekNum   Int
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contents  String
  /// 복사/내보내기 시 빈 항목(금주·차주 모두 내용없음)을 포함할지 — null 이면 전주 설정을 이어받는다
  includeEmpty  Boolean?
  /// 복사/내보내기 시 작성자명([홍길동])을 표시할지 — null 이면 전주 설정을 이어받는다
  includeAuthor Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, year, weekNum])
}

// 주차 진행 단계 — 작성중 → 작성마감 → 취합완료.
//
// isClosed(작성마감)는 공동 편집 주차에만 쓴다. 팀원 입력을 멈춰 룸을 조용하게 만든 뒤에야
// 팀장이 취합본에서 정리할 수 있다. 룸이 살아있는 채로 취합본을 고치면 몇 초 뒤
// 룸의 다음 저장이 그대로 덮어써 팀장이 다듬은 내용이 사라진다.
// isLocked(취합완료)는 그 뒤의 최종 확정이며 기존 의미 그대로다.
model SummaryLock {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  teamId    Int
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  isClosed  Boolean   @default(false)
  closedBy  Int?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([teamId, year, weekNum])
}

model Brief {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  title     String    @default("")
  content   String    @default("")
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([year, weekNum])
}

model ScheduleReport {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  title     String    @default("")
  content   String    @default("")
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([year, weekNum])
}

// ── 실시간 공동 편집 ──────────────────────────────────────────
//
// 팀·주차당 공유 문서 1개. ydoc 이 진실원본이고 contents 는 조회용 파생 JSON이다.
// contents 는 기존 SummaryData.contents 와 형태가 같아 overview/PDF/드라이브 내보내기가
// 테이블만 바꿔 그대로 동작한다.
model SharedDoc {
  id          Int    @id @default(autoincrement())
  // 프리뷰 배포가 운영 문서를 덮어쓰지 않게 하는 방어선. 기본값을 두지 않아 서버가 반드시 지정한다.
  environment String
  teamId      Int
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  year        Int
  weekNum     Int

  ydoc     Bytes // Y.encodeStateAsUpdate(doc)
  contents String @default("{}") // 서버가 ydoc 에서 재계산한 EditorState JSON

  docGeneration Int @default(1) // 복원 시에만 증가. 룸 이름에 포함된다
  writeEpoch    Int @default(1) // 잠금/해제 시 증가. 늦은 저장을 막는 fencing token
  revision      Int @default(0) // 저장 성공 시 증가. 클라이언트 ACK 기준

  seedId     String // 재시드 중복/소실 방지 — 로컬본과 세대가 다르면 폐기시킨다
  seededFrom String   @default("") // "carry:2026-31" | "migrate:summary" | "migrate:reports"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshots SharedDocSnapshot[]

  @@unique([environment, teamId, year, weekNum])
  @@index([year, weekNum])
}

// 복원용 이력. persist 마다 쌓으면 활발한 편집 중 수십 초 만에 밀려나므로
// 일정 간격(interval) + 사건(lock/bulk-delete/pre-restore) 기준으로만 남긴다.
model SharedDocSnapshot {
  id            Int       @id @default(autoincrement())
  docId         Int
  doc           SharedDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  ydoc          Bytes
  docGeneration Int
  revision      Int
  reason        String // "interval" | "lock" | "bulk-delete" | "pre-restore"
  createdAt     DateTime  @default(now())

  @@index([docId, createdAt])
}

// 실제 편집 이벤트 기준의 작성 현황.
// 이월 시드만으로 "작성함"이 되지 않도록 authorId 스캔이 아니라 편집 시각을 기록한다.
model DocActivity {
  id          Int    @id @default(autoincrement())
  environment String
  teamId      Int
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  year        Int
  weekNum     Int
  userId      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastEditedAt DateTime?
  completedAt  DateTime?

  @@unique([environment, teamId, year, weekNum, userId])
  @@index([environment, teamId, year, weekNum])
}

// "이번 주 보고 없음" 선언 — 미작성과 구분해 팀장이 의도적 무보고인지 알 수 있게 한다.
model WritingExcuse {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  year      Int
  weekNum   Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, year, weekNum, userId])
}

// 저장 멱등성 — DB 커밋 후 ACK 만 유실되면 같은 update 가 재전송된다.
// Yjs 내용은 중복되지 않지만 revision/스냅샷/활동기록이 다시 쌓이므로 영수증으로 막는다.
// 요약본(Brief)의 공동 편집 문서.
//
// SharedDoc 과 분리한 이유: Brief 는 팀 구분이 없고(주차당 1개) 본문이 블록 JSON 이 아니라
// TipTap HTML 이다. SharedDoc 의 유니크 키(teamId 포함)와 contents 계약(EditorState)에
// 억지로 끼우면 양쪽 다 망가진다.
//
// 기존 Brief 테이블은 그대로 둔다 — html 을 계속 미러해 롤백 경로를 유지한다.
model BriefDoc {
  id          Int    @id @default(autoincrement())
  environment String
  year        Int
  weekNum     Int

  ydoc  Bytes // Y.encodeStateAsUpdate(doc)
  html  String @default("") // 서버가 ydoc 에서 재계산한 본문 HTML
  title String @default("")

  docGeneration Int @default(1)
  writeEpoch    Int @default(1)
  revision      Int @default(0)

  seedId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots BriefDocSnapshot[]

  @@unique([environment, year, weekNum])
}

// 요약본 복구 지점. 광역 삭제·잠금 확정 시점을 되돌릴 수 있어야 한다 —
// ydoc·html·Brief 미러가 한 트랜잭션에서 같이 비워지므로 이게 없으면 복구 수단이 0이다.
model BriefDocSnapshot {
  id            Int      @id @default(autoincrement())
  docId         Int
  doc           BriefDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  ydoc          Bytes
  docGeneration Int
  revision      Int
  reason        String // "interval" | "lock" | "bulk-delete" | "pre-restore"
  createdAt     DateTime @default(now())

  @@index([docId, createdAt])
}

model PersistReceipt {
  requestId     String   @id
  revision      Int
  // 기록 시점의 세대. 멱등 분기는 이 값을 돌려줘야 한다 —
  // '현재' 세대를 돌려주면 구세대를 든 클라이언트가 재전송만으로 최신 세대를 받아가
  // fencing 을 우회한다.
  docGeneration Int      @default(1)
  writeEpoch    Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model PnlReport {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categories PnlCategory[]

  @@unique([year, weekNum])
}

// 카테고리(Pharos, BIG 등)별 손익 지표 — v1(이전 버전) → v2(최신 버전) 비교
model PnlCategory {
  id       Int       @id @default(autoincrement())
  reportId Int
  report   PnlReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  orderIdx Int       @default(0)

  name    String // "Pharos", "책무구조관리 - 솔루션" 등
  v1Label String @default("") // "v1.41(07.20.)"
  v2Label String @default("") // "v1.43(07.30.)"

  revenueV1     Float @default(0) // 매출금액
  revenueV2     Float @default(0)
  costV1        Float @default(0) // 투입원가
  costV2        Float @default(0)
  grossProfitV1 Float @default(0) // 매출이익
  grossProfitV2 Float @default(0)
  opProfitV1    Float @default(0) // 영업이익
  opProfitV2    Float @default(0)

  note String @default("") // "※ ..." 각주

  @@index([reportId])
}

/// 개선요청 게시판 — 사용자가 직접 올리고 진행 상태를 따라가는 곳.
/// QC 서비스의 이슈 보드를 이 서비스 규모에 맞게 줄여 가져왔다:
/// 번호·구분·상태·담당자·코멘트 스레드까지는 같고, 영역별 작업분배·검증 단계는 뺐다.
model Improvement {
  id      Int    @id @default(autoincrement())
  /// 화면 표시용 연속 번호 (REQ-12). id 를 그대로 쓰면 삭제 후 번호가 튄다.
  seq     Int    @unique
  title   String
  content String @default("")
  /// 구분 — 작성 / 취합 / 조회 / 요약본 / 기타
  category String @default("기타")
  /// open | in_progress | done | hold | rejected
  status  String @default("open")

  createdBy Int
  author    User @relation("improvementAuthor", fields: [createdBy], references: [id], onDelete: Cascade)

  assigneeId Int?
  assignee   User? @relation("improvementAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  comments ImprovementComment[]

  @@index([status, createdAt])
}

model ImprovementComment {
  id            Int         @id @default(autoincrement())
  improvementId Int
  improvement   Improvement @relation(fields: [improvementId], references: [id], onDelete: Cascade)
  authorId      Int
  author        User        @relation("improvementComment", fields: [authorId], references: [id], onDelete: Cascade)
  /// 사람이 쓴 글이면 body, 상태 변경 기록이면 type='status' 와 함께 요약이 들어간다
  body String
  type String @default("comment")
  createdAt DateTime @default(now())

  @@index([improvementId, createdAt])
}
