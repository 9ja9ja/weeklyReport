generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  division  String   @default("") // 문서 "구분": Pharos | 개발 | 영업 | 마케팅 | 운영 | PMO
  orderIdx  Int      @default(0)
  createdAt DateTime @default(now())

  // 공동 편집 컷오버 시점 — 이 주차부터 SharedDoc 을 쓰고 개인 Report 쓰기를 막는다.
  // 팀·주차 단위로 판단해야 이미 공동 편집한 주차를 legacy 로 되돌리는 사고를 막을 수 있다.
  collabFromYear Int?
  collabFromWeek Int?

  users           User[]
  userTeams       UserTeam[]
  parts           Part[]
  majorCategories MajorCategory[]
  categories      Category[]
  summaryData     SummaryData[]
  summaryLocks    SummaryLock[]
  sharedDocs      SharedDoc[]
  docActivities   DocActivity[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  teamId       Int // 주 소속팀
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role         String   @default("user") // "superAdmin" | "teamMaster" | "user"
  position     String   @default("") // 직급: 팀장 | 부팀장 | 매니저 | 프로
  password     String   @default("NOT_SET")
  mustChangePw Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  reports       Report[]
  userTeams     UserTeam[]
  docActivities DocActivity[]

  @@unique([teamId, name])
}

// 겸직 지원: 한 사람이 여러 팀의 보고 항목을 작성
model UserTeam {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}

// 문서 "분류1" — 대분류 위 레벨
model Part {
  id        Int      @id @default(autoincrement())
  name      String
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  majorCategories MajorCategory[]
  categories      Category[]

  @@unique([teamId, name])
}

// 문서 "분류2" — 대분류
model MajorCategory {
  id        Int      @id @default(autoincrement())
  name      String
  partId    Int
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([partId, name])
  @@index([teamId])
}

// 문서 셀 내 "⑴" — 중분류
model Category {
  id        Int      @id @default(autoincrement())
  major     String // MajorCategory.name 과 대응
  middle    String
  partId    Int
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  reportItems ReportItem[]

  @@unique([partId, major, middle])
  @@index([teamId])
}

model Report {
  id      Int  @id @default(autoincrement())
  userId  Int
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  year    Int
  weekNum Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReportItem[]

  @@unique([userId, year, weekNum])
  @@index([year, weekNum])
}

model ReportItem {
  id              Int      @id @default(autoincrement())
  reportId        Int
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentContents String   @default("[]")
  nextContents    String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([reportId, categoryId])
  @@index([categoryId])
}

model SummaryData {
  id        Int      @id @default(autoincrement())
  year      Int
  weekNum   Int
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contents  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, year, weekNum])
}

model SummaryLock {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  teamId    Int
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([teamId, year, weekNum])
}

model Brief {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  title     String    @default("")
  content   String    @default("")
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([year, weekNum])
}

model ScheduleReport {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  title     String    @default("")
  content   String    @default("")
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([year, weekNum])
}

// ── 실시간 공동 편집 ──────────────────────────────────────────
//
// 팀·주차당 공유 문서 1개. ydoc 이 진실원본이고 contents 는 조회용 파생 JSON이다.
// contents 는 기존 SummaryData.contents 와 형태가 같아 overview/PDF/드라이브 내보내기가
// 테이블만 바꿔 그대로 동작한다.
model SharedDoc {
  id          Int    @id @default(autoincrement())
  // 프리뷰 배포가 운영 문서를 덮어쓰지 않게 하는 방어선. 기본값을 두지 않아 서버가 반드시 지정한다.
  environment String
  teamId      Int
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  year        Int
  weekNum     Int

  ydoc     Bytes // Y.encodeStateAsUpdate(doc)
  contents String @default("{}") // 서버가 ydoc 에서 재계산한 EditorState JSON

  docGeneration Int @default(1) // 복원 시에만 증가. 룸 이름에 포함된다
  writeEpoch    Int @default(1) // 잠금/해제 시 증가. 늦은 저장을 막는 fencing token
  revision      Int @default(0) // 저장 성공 시 증가. 클라이언트 ACK 기준

  seedId     String // 재시드 중복/소실 방지 — 로컬본과 세대가 다르면 폐기시킨다
  seededFrom String   @default("") // "carry:2026-31" | "migrate:summary" | "migrate:reports"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshots SharedDocSnapshot[]

  @@unique([environment, teamId, year, weekNum])
  @@index([year, weekNum])
}

// 복원용 이력. persist 마다 쌓으면 활발한 편집 중 수십 초 만에 밀려나므로
// 일정 간격(interval) + 사건(lock/bulk-delete/pre-restore) 기준으로만 남긴다.
model SharedDocSnapshot {
  id            Int       @id @default(autoincrement())
  docId         Int
  doc           SharedDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  ydoc          Bytes
  docGeneration Int
  revision      Int
  reason        String // "interval" | "lock" | "bulk-delete" | "pre-restore"
  createdAt     DateTime  @default(now())

  @@index([docId, createdAt])
}

// 실제 편집 이벤트 기준의 작성 현황.
// 이월 시드만으로 "작성함"이 되지 않도록 authorId 스캔이 아니라 편집 시각을 기록한다.
model DocActivity {
  id          Int    @id @default(autoincrement())
  environment String
  teamId      Int
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  year        Int
  weekNum     Int
  userId      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastEditedAt DateTime?
  completedAt  DateTime?

  @@unique([environment, teamId, year, weekNum, userId])
  @@index([environment, teamId, year, weekNum])
}

// 저장 멱등성 — DB 커밋 후 ACK 만 유실되면 같은 update 가 재전송된다.
// Yjs 내용은 중복되지 않지만 revision/스냅샷/활동기록이 다시 쌓이므로 영수증으로 막는다.
// 요약본(Brief)의 공동 편집 문서.
//
// SharedDoc 과 분리한 이유: Brief 는 팀 구분이 없고(주차당 1개) 본문이 블록 JSON 이 아니라
// TipTap HTML 이다. SharedDoc 의 유니크 키(teamId 포함)와 contents 계약(EditorState)에
// 억지로 끼우면 양쪽 다 망가진다.
//
// 기존 Brief 테이블은 그대로 둔다 — html 을 계속 미러해 롤백 경로를 유지한다.
model BriefDoc {
  id          Int    @id @default(autoincrement())
  environment String
  year        Int
  weekNum     Int

  ydoc  Bytes // Y.encodeStateAsUpdate(doc)
  html  String @default("") // 서버가 ydoc 에서 재계산한 본문 HTML
  title String @default("")

  docGeneration Int @default(1)
  writeEpoch    Int @default(1)
  revision      Int @default(0)

  seedId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots BriefDocSnapshot[]

  @@unique([environment, year, weekNum])
}

// 요약본 복구 지점. 광역 삭제·잠금 확정 시점을 되돌릴 수 있어야 한다 —
// ydoc·html·Brief 미러가 한 트랜잭션에서 같이 비워지므로 이게 없으면 복구 수단이 0이다.
model BriefDocSnapshot {
  id            Int      @id @default(autoincrement())
  docId         Int
  doc           BriefDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  ydoc          Bytes
  docGeneration Int
  revision      Int
  reason        String // "interval" | "lock" | "bulk-delete" | "pre-restore"
  createdAt     DateTime @default(now())

  @@index([docId, createdAt])
}

model PersistReceipt {
  requestId     String   @id
  revision      Int
  // 기록 시점의 세대. 멱등 분기는 이 값을 돌려줘야 한다 —
  // '현재' 세대를 돌려주면 구세대를 든 클라이언트가 재전송만으로 최신 세대를 받아가
  // fencing 을 우회한다.
  docGeneration Int      @default(1)
  writeEpoch    Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model PnlReport {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categories PnlCategory[]

  @@unique([year, weekNum])
}

// 카테고리(Pharos, BIG 등)별 손익 지표 — v1(이전 버전) → v2(최신 버전) 비교
model PnlCategory {
  id       Int       @id @default(autoincrement())
  reportId Int
  report   PnlReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  orderIdx Int       @default(0)

  name    String // "Pharos", "책무구조관리 - 솔루션" 등
  v1Label String @default("") // "v1.41(07.20.)"
  v2Label String @default("") // "v1.43(07.30.)"

  revenueV1     Float @default(0) // 매출금액
  revenueV2     Float @default(0)
  costV1        Float @default(0) // 투입원가
  costV2        Float @default(0)
  grossProfitV1 Float @default(0) // 매출이익
  grossProfitV2 Float @default(0)
  opProfitV1    Float @default(0) // 영업이익
  opProfitV2    Float @default(0)

  note String @default("") // "※ ..." 각주

  @@index([reportId])
}
