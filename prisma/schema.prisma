generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  division  String   @default("") // 문서 "구분": Pharos | 개발 | 영업 | 마케팅 | 운영 | PMO
  orderIdx  Int      @default(0)
  createdAt DateTime @default(now())

  users           User[]
  userTeams       UserTeam[]
  parts           Part[]
  majorCategories MajorCategory[]
  categories      Category[]
  summaryData     SummaryData[]
  summaryLocks    SummaryLock[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  teamId       Int // 주 소속팀
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role         String   @default("user") // "superAdmin" | "teamMaster" | "user"
  position     String   @default("") // 직급: 팀장 | 부팀장 | 매니저 | 프로
  password     String   @default("NOT_SET")
  mustChangePw Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  reports   Report[]
  userTeams UserTeam[]

  @@unique([teamId, name])
}

// 겸직 지원: 한 사람이 여러 팀의 보고 항목을 작성
model UserTeam {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}

// 문서 "분류1" — 대분류 위 레벨
model Part {
  id        Int      @id @default(autoincrement())
  name      String
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  majorCategories MajorCategory[]
  categories      Category[]

  @@unique([teamId, name])
}

// 문서 "분류2" — 대분류
model MajorCategory {
  id        Int      @id @default(autoincrement())
  name      String
  partId    Int
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([partId, name])
  @@index([teamId])
}

// 문서 셀 내 "⑴" — 중분류
model Category {
  id        Int      @id @default(autoincrement())
  major     String // MajorCategory.name 과 대응
  middle    String
  partId    Int
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderIdx  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  reportItems ReportItem[]

  @@unique([partId, major, middle])
  @@index([teamId])
}

model Report {
  id      Int @id @default(autoincrement())
  userId  Int
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  year    Int
  weekNum Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReportItem[]

  @@unique([userId, year, weekNum])
  @@index([year, weekNum])
}

model ReportItem {
  id              Int      @id @default(autoincrement())
  reportId        Int
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentContents String   @default("[]")
  nextContents    String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([reportId, categoryId])
  @@index([categoryId])
}

model SummaryData {
  id        Int      @id @default(autoincrement())
  year      Int
  weekNum   Int
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contents  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, year, weekNum])
}

model SummaryLock {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  teamId    Int
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([teamId, year, weekNum])
}

model Brief {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  title     String    @default("")
  content   String    @default("")
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([year, weekNum])
}

model ScheduleReport {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  title     String    @default("")
  content   String    @default("")
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([year, weekNum])
}

model PnlReport {
  id        Int       @id @default(autoincrement())
  year      Int
  weekNum   Int
  isLocked  Boolean   @default(false)
  lockedBy  Int?
  lockedAt  DateTime?
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categories PnlCategory[]

  @@unique([year, weekNum])
}

// 카테고리(Pharos, BIG 등)별 손익 지표 — v1(이전 버전) → v2(최신 버전) 비교
model PnlCategory {
  id       Int       @id @default(autoincrement())
  reportId Int
  report   PnlReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  orderIdx Int       @default(0)

  name    String // "Pharos", "책무구조관리 - 솔루션" 등
  v1Label String @default("") // "v1.41(07.20.)"
  v2Label String @default("") // "v1.43(07.30.)"

  revenueV1      Float @default(0) // 매출금액
  revenueV2      Float @default(0)
  costV1         Float @default(0) // 투입원가
  costV2         Float @default(0)
  grossProfitV1  Float @default(0) // 매출이익
  grossProfitV2  Float @default(0)
  opProfitV1     Float @default(0) // 영업이익
  opProfitV2     Float @default(0)

  note String @default("") // "※ ..." 각주

  @@index([reportId])
}
