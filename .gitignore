# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local data
*.db
tmp_data.json
scripts/migration-*.js

.vercel
.env*.local

# 운영 DB 백업 (유저 비밀번호 해시 포함 — 절대 커밋 금지)
backup/
.playwright-mcp/

# Cloudflare Worker 로컬 시크릿
.dev.vars
.wrangler/

# Claude Code 개인 설정 — 모델·개인 허용목록이라 사람마다 다르다.
# 공유할 설정은 .claude/settings.json 에 둔다(계속 추적).
.claude/settings.local.json
